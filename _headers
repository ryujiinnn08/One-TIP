/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://img.icons8.com; connect-src 'self'

/*.js
  Cache-Control: no-cache, must-revalidate

/*.css  
  Cache-Control: no-cache, must-revalidate

/Images/*
  Cache-Control: public, max-age=604800
